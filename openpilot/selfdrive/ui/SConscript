import os
from pathlib import Path
Import('env', 'arch', 'common')

# build the fonts
generator = File("#openpilot/selfdrive/assets/fonts/process.py")
source_files = Glob("#openpilot/selfdrive/assets/fonts/*.ttf") + Glob("#openpilot/selfdrive/assets/fonts/*.otf")
output_files = [
  (f"#{Path(f.path).with_suffix('.fnt')}", f"#{Path(f.path).with_suffix('.png')}")
  for f in source_files
  if "NotoColor" not in f.name
]
env.Command(
  target=output_files,
  source=[generator, source_files],
  action=f"python3 {generator}",
)


if GetOption('extras') and arch == "larch64":
  # build installers
  raylib_env = env.Clone()
  raylib_env['LIBPATH'] += [f'#third_party/raylib/{arch}/']
  raylib_env['LINKFLAGS'].append('-Wl,-strip-debug')

  raylib_libs = common + ["raylib"]
  if arch == "larch64":
    raylib_libs += ["GLESv2", "EGL", "gbm", "drm"]
  else:
    raylib_libs += ["GL"]

  release = "release3"
  installers = [
    ("openpilot", release),
    ("openpilot_test", f"{release}-staging"),
    ("openpilot_nightly", "nightly"),
    ("openpilot_internal", "nightly-dev"),
  ]

  # The embedded binary symbol names are derived from the source path passed to `ld`.
  # installer.cc expects paths relative to the openpilot/ dir (e.g. _binary_selfdrive_assets_fonts_Inter_Bold_ttf_*),
  # so run `ld` from that dir with relative source paths regardless of where scons is invoked from.
  op_dir = Dir('#openpilot').abspath
  def embed(target, rel_source):
    return raylib_env.Command(target, os.path.join(op_dir, rel_source),
                              f"cd {op_dir} && ld -r -b binary -o ${{TARGET.abspath}} {rel_source}")

  cont = embed("installer/continue_openpilot.o", "selfdrive/ui/installer/continue_openpilot.sh")
  inter = embed("installer/inter_ttf.o", "selfdrive/ui/installer/inter-ascii.ttf")
  inter_bold = embed("installer/inter_bold.o", "selfdrive/assets/fonts/Inter-Bold.ttf")
  inter_light = embed("installer/inter_light.o", "selfdrive/assets/fonts/Inter-Light.ttf")
  for name, branch in installers:
    d = {'BRANCH': f"'\"{branch}\"'"}
    if "internal" in name:
      d['INTERNAL'] = "1"

    obj = raylib_env.Object(f"installer/installers/installer_{name}.o", ["installer/installer.cc"], CPPDEFINES=d)
    f = raylib_env.Program(f"installer/installers/installer_{name}", [obj, cont, inter, inter_bold, inter_light], LIBS=raylib_libs)
    # keep installers small
    assert f[0].get_size() < 2500*1e3, f[0].get_size()
